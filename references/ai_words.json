  },
  {
   "id": "zh-quanmian",
   "lang": "zh",
   "level": "review",
   "category": "需看语境",
   "pattern": "全面的|全面地",
   "suggest": "说明具体覆盖了什么"
  },
  {
   "id": "zh-zongeryan",
   "lang": "zh",
   "level": "review",
   "category": "套话",
   "pattern": "总而言之|总的来说",
   "suggest": "删去，直接写结论句"
  },
  {
   "id": "zh-nominal",
   "lang": "zh",
   "level": "review",
   "category": "僵尸名词",
   "pattern": "进行了?[^，。；]{0,6}(?:分析|研究|评估|比较|优化|处理)",
   "suggest": "改用动词：分析了… / 比较了…"
  },
  {
   "id": "novel",
   "lang": "en",
   "level": "review",
   "category": "空洞自评",
   "pattern": "\\bnovel\\b",
   "suggest": "默认删掉；新意靠对比体现：Unlike X, which ..., our Y ...（33.6% 的顶会摘要用过，但被审稿人视为空词）"
  },
  {
   "id": "first",
   "lang": "en",
   "level": "review",
   "category": "绝对化断言",
   "pattern": "\\b(?:the|are|is) first\\b",
   "suggest": "写成 To our knowledge, X is the first to ...，并在相关工作说明检索范围"
  },
  {
   "id": "significantly",
   "lang": "en",
   "level": "review",
   "category": "结论强度",
   "pattern": "\\bsignificant(?:ly)?\\b",
   "suggest": "做了显著性检验才用；否则写 by N points / from A to B"
  },
  {
   "id": "sota-bare",
   "lang": "en",
   "level": "review",
   "category": "结论强度",
   "pattern": "\\bstate[- ]of[- ]the[- ]art\\b|\\bSOTA\\b",
   "suggest": "后面紧跟基准名和数字"
  },
  {
   "id": "simple-effective",
   "lang": "en",
   "level": "review",
   "category": "空洞自评",
   "pattern": "\\bsimple (?:yet|but) (?:effective|powerful)\\b",
   "suggest": "用组件数、参数量说明 simple，用数字说明 effective"
  },
  {
   "id": "holistic",
   "lang": "en",
   "level": "review",
   "max": 1,
   "category": "空洞自评",
   "pattern": "\\b(?:holistic|versatile|generalizable|high-fidelity)\\b",
   "suggest": "写出具体维度、支持的任务列表、保真指标或测试过的未见设置"
  },
  {
   "id": "hype",
   "lang": "en",
   "level": "avoid",
   "category": "夸张修饰",
   "pattern": "\\b(?:holy grail|fundamentally break\\w*|staggering|remarkable leap|catastrophic(?:ally)?|innovatively|exceptional(?:ly)?)\\b",
   "suggest": "删除，改为数字对比；形容词强度要和数量级匹配（<1 个点的变化不用情绪化形容词）"
  },
  {
   "id": "absolute-claim",
   "lang": "en",
   "level": "avoid",
   "category": "绝对化断言",
   "pattern": "\\bzero interference\\b|\\bdoes not suffer from any\\b|\\bwithout any (?:loss|limitation)s?\\b",
   "suggest": "改为可测量的表述，并在局限一节说明例外"
  },
  {
   "id": "unlock",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\bunlock(?:s|ed|ing)?\\b|\\bboasts?\\b",
   "suggest": "enable / allow，或直接写出新能力"
  }
 ]
}
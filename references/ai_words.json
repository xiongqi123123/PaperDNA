{
 "_readme": "AI 味与空洞用词表，是唯一来源：scripts/ai_style_scan.py 与 references/word_style.md 第 4 节（去 AI 味规则）都用这份。level=avoid 默认不用；level=review 需逐条判断（领域术语场景下合法）；带 max 的是限量词，同一文件超过 max 次才提示。pattern 是 Python 正则，lang=en 时忽略大小写。上限与频次依据 1040 篇 CVPR 2026 / ICCV 2025 论文统计（references/word_style.md 第 3 节）。",
 "rules": [
  {
   "id": "delve",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\bdelv(?:e|es|ed|ing)\\b",
   "suggest": "examine / investigate / analyze"
  },
  {
   "id": "tapestry",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\btapestry\\b",
   "suggest": "network / combination，或去掉比喻"
  },
  {
   "id": "testament",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\btestament\\b",
   "suggest": "demonstrates / shows"
  },
  {
   "id": "multifaceted",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\bmultifaceted\\b",
   "suggest": "complex / varied"
  },
  {
   "id": "foster",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\bfoster(?:s|ed|ing)?\\b",
   "suggest": "promote / encourage / build"
  },
  {
   "id": "underscore",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\bunderscor(?:e|es|ed|ing)\\b",
   "suggest": "show / emphasize"
  },
  {
   "id": "shed-light",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\bshed(?:s|ding)? (?:new )?light on\\b",
   "suggest": "show / explain"
  },
  {
   "id": "realm",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\brealms?\\b",
   "suggest": "field / area"
  },
  {
   "id": "showcase",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\bshowcas(?:e|es|ed|ing)\\b",
   "suggest": "show / present"
  },
  {
   "id": "meticulous",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\bmeticulous(?:ly)?\\b",
   "suggest": "careful / detailed"
  },
  {
   "id": "embark",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\bembark(?:s|ed|ing)?\\b",
   "suggest": "start / begin"
  },
  {
   "id": "intricate",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\bintrica(?:te|tely|cies)\\b",
   "suggest": "complex / detailed / details"
  },
  {
   "id": "demystify",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\bdemystif(?:y|ies|ied|ying)\\b",
   "suggest": "explain / clarify"
  },
  {
   "id": "utilize",
   "lang": "en",
   "level": "avoid",
   "category": "AI 高频词",
   "pattern": "\\butili[sz](?:e|es|ed|ing|ation)\\b",
   "suggest": "use"
  },
  {
   "id": "worth-noting",
   "lang": "en",
   "level": "avoid",
   "category": "套话",
   "pattern": "\\bit is (?:worth noting|important to note|noteworthy) that\\b",
   "suggest": "删去，直接陈述内容"
  },
  {
   "id": "in-summary",
   "lang": "en",
   "level": "avoid",
   "category": "套话",
   "pattern": "\\b(?:in summary|to summarize|to sum up|in conclusion)\\b",
   "suggest": "删去，直接写结论句"
  },
  {
   "id": "paramount",
   "lang": "en",
   "level": "avoid",
   "category": "夸张修饰",
   "pattern": "\\bparamount\\b",
   "suggest": "删去，或写出具体约束"
  },
  {
   "id": "crucial",
   "lang": "en",
   "level": "avoid",
   "category": "夸张修饰",
   "pattern": "\\bcrucial(?:ly)?\\b",
   "suggest": "全文不超过 2 次；改为 key / necessary，或直接写后果：without X, accuracy drops by N",
   "max": 2
  },
  {
   "id": "vital",
   "lang": "en",
   "level": "avoid",
   "category": "夸张修饰",
   "pattern": "\\bvital(?:ly)?\\b",
   "suggest": "necessary，或用数据说明"
  },
  {
   "id": "pivotal",
   "lang": "en",
   "level": "avoid",
   "category": "夸张修饰",
   "pattern": "\\bpivotal\\b",
   "suggest": "key / central，或说明具体作用"
  },
  {
   "id": "revolutionary",
   "lang": "en",
   "level": "avoid",
   "category": "夸张修饰",
   "pattern": "\\brevolutioni[sz](?:e|es|ed|ing)\\b|\\brevolutionary\\b",
   "suggest": "用数字说明改进幅度"
  },
  {
   "id": "groundbreaking",
   "lang": "en",
   "level": "avoid",
   "category": "夸张修饰",
   "pattern": "\\b(?:groundbreaking|game[- ]chang(?:er|ing))\\b",
   "suggest": "用数字说明改进幅度"
  },
  {
   "id": "unprecedented",
   "lang": "en",
   "level": "avoid",
   "category": "夸张修饰",
   "pattern": "\\bunprecedented\\b",
   "suggest": "给出对比数字"
  },
  {
   "id": "paradigm-shift",
   "lang": "en",
   "level": "avoid",
   "category": "夸张修饰",
   "pattern": "\\bparadigm shifts?\\b|\\ba new paradigm\\b",
   "suggest": "写清改变了哪个具体假设：X removes the need for Y"
  },
  {
   "id": "seamless",
   "lang": "en",
   "level": "avoid",
   "category": "夸张修饰",
   "pattern": "\\bseamless(?:ly)?\\b",
   "suggest": "默认删除；确是即插即用时写出证据：without modifying X / adds N ms latency"
  },
  {
   "id": "cornerstone",
   "lang": "en",
   "level": "avoid",
   "category": "夸张修饰",
   "pattern": "\\bcornerstones?\\b",
   "suggest": "basis / foundation，或说明具体作用"
  },
  {
   "id": "synergy",
   "lang": "en",
   "level": "avoid",
   "category": "领域外行话",
   "pattern": "\\bsynerg(?:y|ies|istic)\\b",
   "suggest": "说明两者如何互补"
  },
  {
   "id": "leverage",
   "lang": "en",
   "level": "review",
   "category": "限量词",
   "pattern": "\\bleverag(?:e|es|ed|ing)\\b",
   "suggest": "全文不超过 2 次且带具体宾语（24% 的顶会摘要用过）；其余改为 use / exploit / build on / draw on，或直接写动作",
   "max": 2
  },
  {
   "id": "undoubtedly",
   "lang": "en",
   "level": "avoid",
   "category": "绝对化断言",
   "pattern": "\\b(?:undoubtedly|unquestionably|indisputabl[ey])\\b",
   "suggest": "删去，让数据说话"
  },
  {
   "id": "this-proves",
   "lang": "en",
   "level": "review",
   "category": "绝对化断言",
   "pattern": "\\b(?:this|which|these results?) (?:clearly )?proves?\\b",
   "suggest": "suggest / indicate（数学证明除外）"
  },
  {
   "id": "obviously",
   "lang": "en",
   "level": "review",
   "category": "绝对化断言",
   "pattern": "\\bobviously\\b",
   "suggest": "删去，或给出理由"
  },
  {
   "id": "transition",
   "lang": "en",
   "level": "review",
   "category": "机械过渡",
   "pattern": "(?:^|(?<=[.!?:]\\s))(?:Furthermore|Moreover|Additionally)\\b",
   "suggest": "用上一句或上一段的关键词承接"
  },
  {
   "id": "nominalization",
   "lang": "en",
   "level": "review",
   "category": "僵尸名词",
   "pattern": "\\b(?:perform(?:s|ed|ing)?|conduct(?:s|ed|ing)?|carr(?:y|ies|ied|ying) out|mak(?:e|es|ing)|made)\\s+(?:an?\\s+|the\\s+)?(?:\\w+\\s+)?\\w+(?:tion|ment|ance|ence|sis)s?\\s+(?:of|on|between)\\b",
   "suggest": "改用动词（evaluate / analyze / compare）"
  },
  {
   "id": "robust",
   "lang": "en",
   "level": "review",
   "category": "需看语境",
   "pattern": "\\brobust(?:ly)?\\b",
   "suggest": "写出对什么扰动鲁棒、扰动多大；鲁棒性术语可保留",
   "max": 3
  },
  {
   "id": "landscape",
   "lang": "en",
   "level": "review",
   "category": "需看语境",
   "pattern": "\\blandscapes?\\b",
   "suggest": "loss landscape 可保留；比喻用法改为 field / state of research"
  },
  {
   "id": "navigate",
   "lang": "en",
   "level": "review",
   "category": "需看语境",
   "pattern": "\\bnavigat(?:e|es|ed|ing)\\b",
   "suggest": "机器人导航可保留；比喻用法改为 handle / address"
  },
  {
   "id": "nuanced",
   "lang": "en",
   "level": "review",
   "category": "需看语境",
   "pattern": "\\bnuanced?\\b",
   "suggest": "subtle / fine-grained，或说明具体差别"
  },
  {
   "id": "orthogonal",
   "lang": "en",
   "level": "review",
   "category": "领域外行话",
   "pattern": "\\borthogonal(?:ly)?\\b",
   "suggest": "数学语境可保留；否则改为 independent / complementary"
  },
  {
   "id": "ecosystem",
   "lang": "en",
   "level": "review",
   "category": "领域外行话",
   "pattern": "\\becosystems?\\b",
   "suggest": "system / environment / community"
  },
  {
   "id": "comprehensive",
   "lang": "en",
   "level": "review",
   "category": "需看语境",
   "pattern": "\\bcomprehensive(?:ly)?\\b",
   "suggest": "默认删掉，或写出覆盖范围：on N datasets spanning A, B, and C"
  },
  {
   "id": "notably",
   "lang": "en",
   "level": "review",
   "category": "需看语境",
   "pattern": "\\bnotably\\b",
   "suggest": "多次出现时删去，直接陈述"
  },
  {
   "id": "harness",
   "lang": "en",
   "level": "review",
   "category": "需看语境",
   "pattern": "\\bharness(?:es|ed|ing)?\\b",
   "suggest": "use（test harness 等名词用法可保留）"
  },
  {
   "id": "zh-wuyong",
   "lang": "zh",
   "level": "avoid",
   "category": "绝对化断言",
   "pattern": "毋庸置疑|不言而喻|不可否认的是",
   "suggest": "删去，用证据支撑"
  },
  {
   "id": "zh-zhide",
   "lang": "zh",
   "level": "avoid",
   "category": "套话",
   "pattern": "值得注意的是|需要指出的是",
   "suggest": "删去，直接陈述"
  },
  {
   "id": "zh-zongshang",
   "lang": "zh",
   "level": "avoid",
   "category": "套话",
   "pattern": "综上所述",

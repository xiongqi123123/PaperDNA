  },
  {
   "id": "zh-lubang",
   "lang": "zh",
   "level": "review",
   "category": "需看语境",
   "pattern": "鲁棒",
   "suggest": "鲁棒性术语可保留；泛泛夸赞时改为具体描述"
  },
  {
   "id": "zh-xianzhu",
   "lang": "zh",
   "level": "review",
   "category": "需看语境",
   "pattern": "显著(?:的|地|提升|提高|改善|优于)",
